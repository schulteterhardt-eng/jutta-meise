---
import BaseLayout from '../layouts/BaseLayout.astro';

const buecher = [
  {
    titel: 'Angekommen',
    untertitel: 'Times of Light and Darkness',
    kategorie: 'Roman',
    jahr: '2024',
    kurztext: 'Roman über Liebe, Verlust und eine Entscheidung, die alles verändert.',
    image: '/buch-angekommen.jpg',
    href: '/buecher/angekommen',
    neu: true,
  },
  {
    titel: 'Einäugig',
    untertitel: 'Eine ungewöhnliche Spurensuche',
    kategorie: 'Roman',
    jahr: '2021',
    kurztext: 'Eine autobiografisch geprägte Spurensuche nach der früh verstorbenen Zwillingsschwester.',
    image: '/buch-einaeugig.jpg',
    href: '/buecher/einaeugig',
  },
  {
    titel: 'Lessings Anglophilie',
    untertitel: 'Dissertationsschrift',
    kategorie: 'Dissertationsschrift',
    jahr: '1993',
    kurztext: 'Wissenschaftliche Arbeit zur Anglophilie Gotthold Ephraim Lessings.',
    image: '/images/lessings-anglophilie/cover-lessings-anglophilie.webp',
    href: '/buecher/lessings-anglophilie',
  },
];
---

<BaseLayout
  title="Bücher – Dr. Jutta Meise"
  description="Die Bücher von Dr. Jutta Meise: Angekommen, Einäugig und Lessings Anglophilie – Romane, Spurensuche und Dissertation."
>

  <!-- Hero -->
  <section style="background: var(--color-parchment); border-bottom: 1px solid var(--color-sand);" class="px-8 sm:px-14 lg:px-20 pt-28 pb-14 sm:pt-36 sm:pb-16">
    <div class="max-w-6xl mx-auto">
      <p class="t-label mb-8">Werke</p>
      <h1 class="t-display" style="font-size: clamp(2.5rem, 5vw, 4rem);">Bücher</h1>
      <div class="rule mt-8"></div>
    </div>
  </section>


  <!-- Buchkarten -->
  <section style="background: var(--color-parchment);" class="py-14 sm:py-20 px-8 sm:px-14 lg:px-20">
    <div class="max-w-6xl mx-auto grid sm:grid-cols-2 lg:grid-cols-3 gap-10 sm:gap-12">
      {buecher.map(buch => (
        <article style="display: flex; flex-direction: column; gap: 1.25rem;">

          <a href={buch.href} style="display: block; overflow: hidden; box-shadow: 0 8px 32px rgba(0,0,0,0.14); flex-shrink: 0;">
            <img
              src={buch.image}
              alt={buch.titel}
              loading="eager"
              style="width: 100%; aspect-ratio: 2/3; object-fit: cover; display: block;"
            />
          </a>

          <div style="display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
            <p class="t-label-petrol">{buch.kategorie} · {buch.jahr}{buch.neu ? ' · Neuerscheinung' : ''}</p>
            <h2 class="t-heading" style="font-size: clamp(1.25rem, 2vw, 1.625rem);">{buch.titel}</h2>
            <p style="font-family: var(--font-body); color: var(--color-subtle); font-style: italic; font-size: 0.9rem;">{buch.untertitel}</p>
            <p class="t-prose" style="font-size: 0.9rem; margin-top: 0.25rem; line-height: 1.6;">{buch.kurztext}</p>
            <a href={buch.href} class="btn-primary" style="margin-top: 0.875rem; align-self: flex-start;">Mehr erfahren</a>
          </div>

        </article>
      ))}
    </div>
  </section>


  <!-- Abschluss -->
  <section style="background: var(--color-cream); border-top: 1px solid var(--color-sand);" class="px-8 sm:px-14 lg:px-20 py-8">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <p style="font-family: var(--font-body); color: var(--color-subtle); font-style: italic; font-size: 0.9375rem;">
        Für Leseexemplare oder Presseanfragen bitte direkt Kontakt aufnehmen.
      </p>
      <a href="/kontakt" class="text-link">Kontakt →</a>
    </div>
  </section>

</BaseLayout>
