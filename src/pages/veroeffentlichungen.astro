---
import BaseLayout from '../layouts/BaseLayout.astro';

const kategorien = [
  {
    titel: 'Bücher',
    gridClass: 'grid sm:grid-cols-2 lg:grid-cols-3 gap-8',
    btnClass: 'btn-primary',
    eintraege: [
      {
        titel: 'Angekommen – Times of Light and Darkness',
        quelle: 'Books on Demand',
        jahr: '2024',
        sprache: 'Deutsch',
        image: '/buch-angekommen.jpg',
        imageAlt: 'Angekommen',
        link: '/buecher/angekommen',
        linkLabel: 'Zum Buch',
        extern: false,
      },
      {
        titel: 'Einäugig – Eine ungewöhnliche Spurensuche',
        quelle: 'Books on Demand',
        jahr: '2021',
        sprache: 'Deutsch',
        image: '/buch-einaeugig.jpg',
        imageAlt: 'Einäugig',
        link: '/buecher/einaeugig',
        linkLabel: 'Zum Buch',
        extern: false,
      },
      {
        titel: 'Lessings Anglophilie',
        quelle: 'Peter Lang Verlag',
        jahr: '1993',
        sprache: 'Deutsch',
        image: '/images/lessings-anglophilie/cover-lessings-anglophilie.webp',
        imageAlt: 'Lessings Anglophilie',
        link: 'https://www.amazon.de/Lessings-Anglophilie-Europ%C3%A4ische-Aufkl%C3%A4rung-Literatur/dp/3631313012',
        linkLabel: 'Zum Buch',
        extern: true,
      },
    ],
  },
  {
    titel: 'Weitere Veröffentlichungen',
    gridClass: 'grid sm:grid-cols-3 gap-8',
    btnClass: 'btn-primary',
    eintraege: [
      {
        titel: 'Traditionsgeschäfte auf der Dinslakener Neustraße – Neustraße 46',
        quelle: 'Jahrbuch des Kreises Wesel',
        jahr: '2024',
        sprache: 'Deutsch',
        image: '/images/Jahrbuecher/jahrbuch-2024-kreis-wesel.webp',
        imageAlt: 'Jahrbuch des Kreises Wesel 2024',
        pdf: '/pdfs/verlagstext-neustr-46-2024.pdf',
        linkLabel: 'Verlagstext lesen',
      },
      {
        titel: 'Traditionsgeschäfte auf der Dinslakener Neustraße – Neustraße 38',
        quelle: 'Jahrbuch des Kreises Wesel',
        jahr: '2025',
        sprache: 'Deutsch',
        image: '/images/Jahrbuecher/jahrbuch-2025-kreis-wesel.webp',
        imageAlt: 'Jahrbuch des Kreises Wesel 2025',
        pdf: '/pdfs/verlagstext-neustr-38-2025.pdf',
        linkLabel: 'Verlagstext lesen',
      },
      {
        titel: 'Traditionsgeschäfte auf der Dinslakener Neustraße – Neustraße 13',
        quelle: 'Jahrbuch des Kreises Wesel',
        jahr: '2026',
        sprache: 'Deutsch',
        image: '/images/Jahrbuecher/jahrbuch-2026-kreis-wesel.webp',
        imageAlt: 'Jahrbuch des Kreises Wesel 2026',
        pdf: '/pdfs/verlagstext-neustr-13-2026.pdf',
        linkLabel: 'Verlagstext lesen',
      },
    ],
  },
  {
    titel: 'Presse & Medien',
    gridClass: 'grid sm:grid-cols-2 gap-8',
    btnClass: 'btn-primary',
    eintraege: [
      {
        titel: 'Dinslakener Autorin auf Spurensuche nach Zwillingsschwester',
        quelle: 'NRZ – Neue Ruhr Zeitung',
        jahr: '2021',
        sprache: 'Deutsch',
        link: 'https://www.nrz.de/staedte/dinslaken-huenxe-voerde/article240582974/Dinslakener-Autorin-auf-Spurensuche-nach-Zwillingsschwester.html',
        linkLabel: 'Artikel öffnen',
        extern: true,
      },
      {
        titel: 'Dinslakenerin plant Buch über die Geschichte der Neustraße',
        quelle: 'NRZ – Neue Ruhr Zeitung',
        jahr: '2020',
        sprache: 'Deutsch',
        link: 'https://www.nrz.de/staedte/dinslaken-huenxe-voerde/article234563143/Dinslakenerin-plant-Buch-ueber-die-Geschichte-der-Neustrasse.html',
        linkLabel: 'Artikel öffnen',
        extern: true,
      },
    ],
  },
];
---

<BaseLayout
  title="Veröffentlichungen – Dr. Jutta Meise"
  description="Essays, Artikel und Beiträge von Dr. Jutta Meise – auf Deutsch und Englisch."
>

  <!-- Hero -->
  <section style="background: var(--color-parchment); border-bottom: 1px solid var(--color-sand);" class="px-8 sm:px-14 lg:px-20 pt-28 pb-14 sm:pt-36 sm:pb-16">
    <div class="max-w-6xl mx-auto">
      <p class="t-label mb-8">Texte</p>
      <h1 class="t-display" style="font-size: clamp(2.5rem, 5vw, 4rem);">Veröffentlichungen</h1>
      <div class="rule mt-8"></div>
    </div>
  </section>


  <!-- Publikationen -->
  <section style="background: var(--color-parchment);" class="px-8 sm:px-14 lg:px-20 py-14 sm:py-20">
    <div class="max-w-6xl mx-auto" style="display: flex; flex-direction: column; gap: 3.5rem;">

      {kategorien.map(kat => (
        <div>

          <!-- Kategorie-Überschrift -->
          <div class="flex items-center gap-8 mb-8">
            <h2 class="t-heading" style="font-size: clamp(1.25rem, 2vw, 1.5rem); white-space: nowrap;">{kat.titel}</h2>
            <div style="flex: 1; height: 1px; background: var(--color-sand);"></div>
          </div>

          <!-- Karten-Grid -->
          <div class={kat.gridClass}>
            {kat.eintraege.map(e => (
              <article style="display: flex; flex-direction: column;">
                <div style="display: flex; flex-direction: column; flex: 1;">

                  {/* Cover-Bild, falls vorhanden */}
                  {e.image && (
                    <div style="overflow: hidden; height: 200px; box-shadow: 0 4px 16px rgba(0,0,0,0.12);">
                      <img
                        src={e.image}
                        alt={e.imageAlt}
                        loading="lazy"
                        style="width: 100%; height: 100%; object-fit: cover; display: block;"
                      />
                    </div>
                  )}

                  {/* Kein Bild: dezenте Akzentlinie oben */}
                  {!e.image && (
                    <div style="height: 2px; background: var(--color-petrol);"></div>
                  )}

                  {/* Text & Button */}
                  <div style="display: flex; flex-direction: column; flex: 1; gap: 0.375rem; padding-top: 0.875rem;">
                    <p class="t-label-petrol">{e.sprache} · {e.jahr}</p>
                    <h3 style="font-family: var(--font-serif); color: var(--color-ink); font-size: 0.9375rem; font-weight: 400; line-height: 1.4;">{e.titel}</h3>
                    <p class="t-label" style="margin-bottom: 0; line-height: 1.5;">{e.quelle}</p>

                    {/* PDF-Link */}
                    {e.pdf && (
                      <a
                        href={e.pdf}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={kat.btnClass}
                        style="margin-top: 0.875rem; align-self: flex-start;"
                      >{e.linkLabel}</a>
                    )}

                    {/* Interner oder externer Link */}
                    {!e.pdf && e.link && (
                      <a
                        href={e.link}
                        target={e.extern ? '_blank' : undefined}
                        rel={e.extern ? 'noopener noreferrer' : undefined}
                        class={kat.btnClass}
                        style="margin-top: 0.875rem; align-self: flex-start;"
                      >{e.linkLabel}</a>
                    )}
                  </div>

                </div>
              </article>
            ))}
          </div>

        </div>
      ))}

    </div>
  </section>


  <!-- Abschluss -->
  <section style="background: var(--color-cream); border-top: 1px solid var(--color-sand);" class="px-8 sm:px-14 lg:px-20 py-8">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6">
      <p style="font-family: var(--font-body); color: var(--color-subtle); font-style: italic; font-size: 0.9375rem;">
        Für vollständige bibliografische Angaben, Rezensionen<br />oder Kooperationsanfragen stehe ich gerne zur Verfügung.
      </p>
      <a href="/kontakt" class="text-link">Kontakt →</a>
    </div>
  </section>

</BaseLayout>
