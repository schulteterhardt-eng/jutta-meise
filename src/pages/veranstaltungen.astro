---
import BaseLayout from '../layouts/BaseLayout.astro';

const kommend: { datum: string; uhrzeit: string; titel: string; ort: string; info: string; tickets: string }[] = [];

const vergangen = [
  {
    datum: '14. August 2025',
    titel: 'Lesung in der LESEZEIT',
    ort: 'Buchhandlung LESEZEIT, Bahnhofstraße 61, Voerde',
    foto: '/images/veranstaltungen/lesezeit/lesung-lesezeit-1.jpg',
    fotoAlt: 'Dr. Jutta Meise bei der Lesung in der LESEZEIT in Voerde',
    flyer: '/images/veranstaltungen/lesezeit/flyer-angekommen-lesezeit-2025-08-14.jpg',
    flyerAlt: 'Flyer zur Lesung Angekommen in der Buchhandlung LESEZEIT',
    beschreibung: 'Rückblick auf die Lesung aus „Angekommen – Times of Light and Darkness“ mit Gespräch in der Buchhandlung LESEZEIT in Voerde.',
    presseBilder: [
      {
        src: '/images/veranstaltungen/lesezeit/presse-nrz-voerde-2025-07-23.jpg',
        alt: 'NRZ Voerde vom 23.7.2025',
        titel: 'NRZ Voerde',
        datum: '23.7.2025',
      },
      {
        src: '/images/veranstaltungen/lesezeit/presse-rp-voerde-2025-07-24.jpg',
        alt: 'Rheinische Post Voerde vom 24.7.2025',
        titel: 'Rheinische Post Voerde',
        datum: '24.7.2025',
      },
    ],
  },
];
---

<BaseLayout
  title="Veranstaltungen – Dr. Jutta Meise"
  description="Lesungen, Gespräche und Veranstaltungen mit Dr. Jutta Meise – aktuelle Termine und Rückblick."
>

  <!-- Hero -->
  <section style="background: var(--color-parchment); border-bottom: 1px solid var(--color-sand);" class="px-8 sm:px-14 lg:px-20 pt-28 pb-16 sm:pt-36 sm:pb-20">
    <div class="max-w-6xl mx-auto">
      <p class="t-label mb-8">Termine</p>
      <h1 class="t-display" style="font-size: clamp(2.5rem, 5vw, 4rem);">Veranstaltungen</h1>
      <div class="rule mt-8"></div>
    </div>
  </section>


  <!-- Kommende Veranstaltungen -->
  <section style="background: var(--color-parchment);" class="px-8 sm:px-14 lg:px-20 py-28 sm:py-36">
    <div class="max-w-6xl mx-auto">

      <div class="flex items-center gap-8 mb-14">
        <h2 class="t-heading" style="font-size: clamp(1.5rem, 2.5vw, 2rem); white-space: nowrap;">Kommende Termine</h2>
        <div style="flex: 1; height: 1px; background: var(--color-sand);"></div>
      </div>

      {kommend.length === 0 ? (
        <div style="border-left: 2px solid var(--color-sand); padding-left: 2rem; max-width: 40ch;">
          <p style="font-family: var(--font-serif); color: var(--color-subtle); font-style: italic; font-size: 1.0625rem; margin-bottom: 0.5rem;">
            Derzeit keine Termine geplant.
          </p>
          <p class="t-label">Neue Veranstaltungen werden hier rechtzeitig angekündigt.</p>
        </div>
      ) : (
        <div class="space-y-6">
          {kommend.map(v => (
            <article style="border-left: 2px solid var(--color-petrol); padding-left: 2rem;">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
                <div>
                  <p class="t-label-petrol mb-2">{v.datum} · {v.uhrzeit}</p>
                  <h3 class="t-title">{v.titel}</h3>
                </div>
                {v.tickets && (
                  <a href={v.tickets} target="_blank" rel="noopener noreferrer" class="btn-primary flex-shrink-0">
                    Tickets
                  </a>
                )}
              </div>
              <p class="t-label mb-3">{v.ort}</p>
              <p class="t-prose">{v.info}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>


  <!-- Rückblick -->
  <section style="background: var(--color-cream);" class="px-8 sm:px-14 lg:px-20 py-24 sm:py-28">
    <div class="max-w-6xl mx-auto">

      <div class="flex items-center gap-8 mb-10">
        <h2 class="t-heading" style="font-size: clamp(1.25rem, 2vw, 1.5rem); white-space: nowrap; opacity: 0.5;">Rückblick</h2>
        <div style="flex: 1; height: 1px; background: var(--color-sand);"></div>
      </div>

      <div>
        {vergangen.map(v => (
          <div style="border-bottom: 1px solid var(--color-sand);" class="py-8">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-4" style="opacity: 0.6;">
              <div>
                <p style="font-family: var(--font-serif); color: var(--color-ink); font-size: 1rem;">{v.titel}</p>
                <p class="t-label mt-1">{v.ort}</p>
              </div>
              <span class="t-label flex-shrink-0">{v.datum}</span>
            </div>
            {v.beschreibung && (
              <p class="t-prose" style="max-width: 58ch; margin-bottom: 1.25rem;">
                {v.beschreibung}
              </p>
            )}

            {(v.foto || v.flyer) && (
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; max-width: 760px; margin-bottom: 1.25rem;">
                {v.foto && (
                  <figure style="margin: 0;">
                    <a href={v.foto} target="_blank" rel="noopener noreferrer">
                      <img
                        src={v.foto}
                        alt={v.fotoAlt}
                        style="width: 100%; height: auto; opacity: 0.9;"
                      />
                    </a>
                    <figcaption class="t-label" style="margin-top: 0.5rem; opacity: 0.55;">Foto der Lesung</figcaption>
                  </figure>
                )}
                {v.flyer && (
                  <figure style="margin: 0;">
                    <a href={v.flyer} target="_blank" rel="noopener noreferrer">
                      <img
                        src={v.flyer}
                        alt={v.flyerAlt}
                        style="width: 100%; height: auto; opacity: 0.9;"
                      />
                    </a>
                    <figcaption class="t-label" style="margin-top: 0.5rem; opacity: 0.55;">Flyer zur Lesung</figcaption>
                  </figure>
                )}
              </div>
            )}

            {v.presseBilder && v.presseBilder.length > 0 && (
              <div style="margin-top: 1rem;">
                <p class="t-label" style="opacity: 0.55; margin-bottom: 0.75rem;">Pressehinweise</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.875rem; max-width: 760px;">
                  {v.presseBilder.map(p => (
                    <figure style="margin: 0;">
                      <a href={p.src} target="_blank" rel="noopener noreferrer">
                        <img
                          src={p.src}
                          alt={p.alt}
                          style="width: 100%; height: auto; opacity: 0.86;"
                        />
                      </a>
                      <figcaption class="t-label" style="margin-top: 0.5rem; opacity: 0.55;">{p.titel} · {p.datum}</figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- Lesungsanfrage -->
  <section style="background: var(--color-cream); border-top: 1px solid var(--color-sand);" class="px-8 sm:px-14 lg:px-20 py-32 sm:py-36">
    <div class="max-w-4xl">
      <p class="t-label mb-8">Anfragen</p>
      <p class="t-quote" style="font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.4; margin-bottom: 1.5rem;">
        Lesung für Ihre Veranstaltung?
      </p>
      <p style="font-family: var(--font-body); color: var(--color-subtle); font-size: 0.9375rem; line-height: 1.8; max-width: 44ch; margin-bottom: 2.5rem;">
        Für Anfragen zu Lesungen, Podiumsgesprächen oder literarischen Abenden stehe ich gerne zur Verfügung.
      </p>
      <a href="/kontakt" class="btn-ghost">Anfrage stellen →</a>
    </div>
  </section>

</BaseLayout>
